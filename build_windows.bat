@echo off
REM ============================================================================
REM  Builds the two Windows programs (ENS_Image_Database.exe, Spectral_Analyzer.exe)
REM  Requirements: Python 3.10 to 3.15, 64-bit, from python.org (tick "Add to PATH").
REM  Double-click this file. The programs are created in the "dist" folder and
REM  packed into ENS_Tools_Windows.zip. Full log: build_log.txt
REM ============================================================================
setlocal
cd /d "%~dp0"
set LOG=%~dp0build_log.txt
echo Build started %DATE% %TIME% > "%LOG%"

echo [0/6] Removing files generated by a previous build or copied from another PC...
REM A Python virtual environment (.venv) only works on the PC and Python version that
REM created it, so it is always rebuilt from scratch.
for %%D in (.venv build dist .pytest_cache) do if exist "%%D" rmdir /s /q "%%D"
for /d /r . %%D in (__pycache__) do if exist "%%D" rmdir /s /q "%%D"
if exist ENS_Tools_Windows.zip del /q ENS_Tools_Windows.zip
if exist dist (echo Cannot delete the old "dist" folder: close ENS_Image_Database and Spectral_Analyzer, then run this file again. & goto :error)
if exist .venv (echo Cannot delete the old ".venv" folder: close VS Code or any terminal using it, then run this file again. & goto :error)

echo [1/6] Checking Python...
set PY=python
where py >nul 2>nul && set PY=py -3
%PY% -c "import sys, struct; print('Python', sys.version.split()[0], struct.calcsize('P') * 8, 'bit')" || (echo Python not found: install it from python.org and tick "Add python.exe to PATH". & goto :error)
%PY% -c "import sys, struct; sys.exit(0 if (3, 10) <= sys.version_info[:2] <= (3, 15) and struct.calcsize('P') == 8 else 1)" || (echo This Python version is not supported: use Python 3.10 to 3.15, 64-bit. & goto :error)

echo [2/6] Creating a fresh virtual environment...
%PY% -m venv .venv >> "%LOG%" 2>&1 || goto :error
set VPY=.venv\Scripts\python.exe

echo [3/6] Installing the libraries (a few minutes, needs internet)...
%VPY% -m pip install --upgrade pip >> "%LOG%" 2>&1 || goto :error
%VPY% -m pip install -r requirements.txt >> "%LOG%" 2>&1 || goto :error

echo [4/6] Running the automated tests...
%VPY% -m pytest -q -p no:cacheprovider tests >> "%LOG%" 2>&1 || goto :error

echo [5/6] Building ENS_Image_Database...
%VPY% -m PyInstaller --noconfirm --clean ens_database.spec >> "%LOG%" 2>&1 || goto :error
echo [6/6] Building Spectral_Analyzer...
%VPY% -m PyInstaller --noconfirm --clean spectral_analyzer.spec >> "%LOG%" 2>&1 || goto :error

REM The "build" folder only holds intermediate files (its .exe files cannot run).
if exist build rmdir /s /q build
echo.
echo Build finished:
echo   dist\ENS_Image_Database\ENS_Image_Database.exe
echo   dist\Spectral_Analyzer\Spectral_Analyzer.exe
echo.
echo Packing everything into ENS_Tools_Windows.zip...
call make_zip.bat
exit /b 0

:error
echo.
echo BUILD FAILED. Last lines of build_log.txt:
echo ----------------------------------------------------------------------------
powershell -NoProfile -Command "if (Test-Path '%LOG%') { Get-Content -Tail 25 '%LOG%' }"
echo ----------------------------------------------------------------------------
echo Send build_log.txt to get help.
pause
exit /b 1
